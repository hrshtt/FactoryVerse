# FactoryVerse Global Configuration
# Copy this file to .env and customize as needed

# ===== RCON Connection (Shared Across All Agents) =====
RCON_HOST=localhost
RCON_PORT=27100
RCON_PWD=factorio

# ===== Server Configuration (FV_ prefix auto-loaded) =====
# Docker image for Factorio server
FV_DOCKER_IMAGE=factoriotools/factorio:2.0.72

# UDP Ports
FV_SNAPSHOT_PORT=34400            # Snapshot mod sends notifications here
FV_AGENT_PORT_BASE=34202          # Base port for agent UDP (agent 0 = 34202, agent 1 = 34203, etc.)
FV_ENABLE_UDP_PORT=34200          # Port for --enable-lua-udp (Factorio's incoming listener, rarely used)
FV_MAX_AGENTS=10                  # Max agents per server (determines port range)

# Port bases for multi-server setups
FV_RCON_PORT_BASE=27000           # RCON port base (server 0 = 27000, server 1 = 27001, etc.)
FV_GAME_PORT_BASE=34197           # Game UDP port base

# Map generation
FV_MAP_GEN_SEED=44340             # Seed for reproducible maps
FV_DEFAULT_SCENARIO=test-ground   # Default scenario to load

# Optional: expose Factorio's incoming UDP listener
FV_EXPOSE_INCOMING_UDP=false

# ===== Base Paths (Shared) =====
# Factorio script-output directory (auto-detected if not set)
# On macOS: /Users/<user>/Library/Application Support/factorio/script-output
# On Linux: ~/.factorio/script-output
# On Windows: %APPDATA%/Factorio/script-output
# FACTORIO_SCRIPT_OUTPUT_DIR=/path/to/factorio/script-output
FV_OUTPUT_DIR=
FACTORYVERSE_SNAPSHOT_DIR=
FACTORYVERSE_DUMP_FILE=
FACTORIO_SCRIPT_OUTPUT_DIR=

# ===== LLM Configuration =====
PRIME_API_KEY=your_api_key_here

# ===== Per-Agent Runtime Config (Set by Agent Runtime) =====
# These are set automatically by the agent runtime, not in .env:
# - FV_SESSION_DIR: Session directory for this agent
# - FV_AGENT_ID: Agent identifier (e.g., "agent_1", "agent_2")
# - FV_AGENT_UDP_PORT: (Optional) Explicit UDP port override
