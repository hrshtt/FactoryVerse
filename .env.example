# FactoryVerse Configuration
# Copy this file to .env and customize as needed
# All settings use the FV_ prefix

# =============================================================================
# RCON Configuration
# =============================================================================

# RCON host (shared)
FV_RCON_HOST=localhost

# Client RCON port (fixed, separate from server pool)
FV_RCON_CLIENT_PORT=27100

# Server RCON port base (server N uses base + N)
# server_0 = 27000, server_1 = 27001, etc.
FV_RCON_SERVER_PORT_BASE=27000

# RCON password (shared)
FV_RCON_PASSWORD=factorio

# =============================================================================
# Docker Configuration
# =============================================================================

# Docker image for Factorio server
FV_DOCKER_IMAGE=factoriotools/factorio:2.0.72

# Force AMD64 platform even on ARM (uses emulation)
FV_FORCE_AMD64=false

# =============================================================================
# Port Configuration
# =============================================================================

# Base game UDP port for servers (server N uses base + N)
FV_GAME_PORT_BASE=34197

# Base UDP port for agent action notifications
# Agent 0 = 34202, Agent 1 = 34203, etc.
FV_AGENT_PORT_BASE=34202

# UDP port for snapshot/sync notifications
FV_SNAPSHOT_PORT=34400

# Port for --enable-lua-udp (Factorio's incoming UDP listener)
FV_ENABLE_UDP_PORT=34200

# Maximum agents per server (determines UDP port range)
FV_MAX_AGENTS=10

# Expose Factorio's incoming UDP listener port to host (rarely needed)
FV_EXPOSE_INCOMING_UDP=false

# =============================================================================
# Map & Scenario Configuration
# =============================================================================

# Map generation seed for reproducibility
FV_MAP_GEN_SEED=44340

# Default scenario to load
FV_DEFAULT_SCENARIO=test-ground

# =============================================================================
# Path Overrides (optional - auto-detected if not set)
# =============================================================================

# Override .fv-output directory
# FV_OUTPUT_DIR=/path/to/.fv-output

# =============================================================================
# LLM Configuration
# =============================================================================

# Default provider + model when no --provider/--model flag is passed.
# Providers: prime_intellect | deepseek | openai | azure | local
# LLM_PROVIDER=prime_intellect
# LLM_MODEL=anthropic/claude-sonnet-4.6

# Prime Intellect (gateway; default provider)
PRIME_API_KEY=your_api_key_here

# DeepSeek first-party platform API (https://platform.deepseek.com)
# Used by: fv run -p deepseek
# Default model: deepseek-v4-pro (also: deepseek-v4-flash)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI (optional)
# OPENAI_API_KEY=your_openai_api_key_here
